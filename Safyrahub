local function melhorOvoV2()
    local ovos = listarOvosCache()
    if #ovos == 0 then return nil end
    if not States.ESPAreaAtual then return ovos[1] end
    local char = LocalPlayer.Character
    local hrp = char and char:FindFirstChild("HumanoidRootPart")
    if not hrp then return ovos[1] end
    local areas = workspace:FindFirstChild("World")
    areas = areas and areas:FindFirstChild("Areas")
    areas = areas and areas:FindFirstChild("GuardAreas")
    if not areas then return ovos[1] end
    local areaAtual = nil
    local menorDist = math.huge
    for _, area in ipairs(areas:GetChildren()) do
        local ok, result, size = pcall(function() return area:GetBoundingBox() end)
        if ok and result and size then
            local pos = result:PointToObjectSpace(hrp.Position)
            if math.abs(pos.X) <= size.X/2 and math.abs(pos.Z) <= size.Z/2 then
                areaAtual = area.Name; break
            end
        end
        local pivot = area:GetPivot().Position
        local d = (Vector3.new(pivot.X, 0, pivot.Z) - Vector3.new(hrp.Position.X, 0, hrp.Position.Z)).Magnitude
        if d < menorDist then menorDist = d; areaAtual = area.Name end
    end
    if not areaAtual then return ovos[1] end
    for _, ovo in ipairs(ovos) do
        if ovo.Area == areaAtual then return ovo end
    end
    return ovos[1]
end

