local function addLog(msg)
    local t = os.date("%H:%M:%S") .. " " .. tostring(msg)
    table.insert(LOG, t)
    if #LOG > 100 then table.remove(LOG, 1) end
    print("[SAFYRA] " .. t)
    if _G.SafyraLogUpdate then pcall(_G.SafyraLogUpdate) end
end

local function formatarValor(v)
    v = tonumber(v) or 0
    if v >= 1e12 then return string.format("%.2fT", v/1e12)
    elseif v >= 1e9 then return string.format("%.2fB", v/1e9)
    elseif v >= 1e6 then return string.format("%.2fM", v/1e6)
    elseif v >= 1e3 then return string.format("%.1fK", v/1e3)
    else return tostring(math.floor(v)) end
end

