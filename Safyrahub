local function makeBtn(parent, y, text)
    local b = Instance.new("TextButton")
    b.Size = UDim2.new(1, -10, 0, 32); b.Position = UDim2.new(0, 5, 0, y)
    b.BackgroundColor3 = COR_OFF
    b.Text = ""; b.BorderSizePixel = 0
    b.AutoButtonColor = false; b.ZIndex = 11; b.Parent = parent
    Instance.new("UICorner", b).CornerRadius = UDim.new(0, 6)
    local s = Instance.new("UIStroke", b); s.Color = COR_OFF_STROKE; s.Thickness = 1; s.Transparency = 0.5
    local tx = Instance.new("TextLabel", b)
    tx.Size = UDim2.new(1, 0, 1, 0); tx.BackgroundTransparency = 1
    tx.Text = text; tx.TextColor3 = Color3.fromRGB(255, 255, 255)
    tx.Font = Enum.Font.GothamBold; tx.TextSize = 12; tx.ZIndex = 12
    return b, s, tx
end

local function setBtnOn(btn, stroke, on)
    if on then
        btn.BackgroundColor3 = COR_ON
        stroke.Color = COR_ON_STROKE
    else
        btn.BackgroundColor3 = COR_OFF
        stroke.Color = COR_OFF_STROKE
    end
end

