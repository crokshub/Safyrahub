local function switchTab(name)
    for n, btn in pairs(tabButtons) do
        local ativo = (n == name)
        btn.BackgroundColor3 = ativo and Color3.fromRGB(138, 43, 226) or COR_OFF
        btn.BackgroundTransparency = ativo and 0.1 or 0.3
        btn.TextColor3 = ativo and Color3.fromRGB(255, 255, 255) or Color3.fromRGB(180, 180, 200)
        btn.Font = ativo and Enum.Font.GothamBold or Enum.Font.GothamSemibold
        tabContainers[n].Visible = ativo
    end
end

for name, btn in pairs(tabButtons) do
