local function getEggInfo(category)
    if not Assets or not Assets.Directory then return nil end
    local data = Assets.Directory[category]
    if not data then return nil end
    local rarity = data.Rarity
    local rarName, rarColor = "?", Color3.fromRGB(200,200,200)
    if type(rarity) == "table" then
        rarName = rarity.DisplayName or rarity.Name or rarity._id or "?"
        if typeof(rarity.Color) == "Color3" then rarColor = rarity.Color
        elseif typeof(rarity.Color) == "ColorSequence" then rarColor = rarity.Color.Keypoints[1].Value end
    end
    return { Nome = data.DisplayName or category, Icon = data.Icon or "", Valor = data.EarningRate or 0, Raridade = rarName, Cor = rarColor }
end

local function listarOvos()
    if not Snapshot then return {} end
    local ok, r = pcall(function() return Snapshot:InvokeServer() end)
    if not ok or not r or not r.Records then return {} end
    local ovos = {}
    for _, rec in ipairs(r.Records) do
        if (rec.State == "Slot" or rec.State == "Dropped") and rec.AssetCategory then
            local info = getEggInfo(rec.AssetCategory)
            if info then
                table.insert(ovos, { Uid=rec.Uid, Categoria=rec.AssetCategory, Nome=info.Nome, Icon=info.Icon,
                    Valor=info.Valor, Raridade=info.Raridade, Cor=info.Cor, Area=rec.AreaId or "?",
                    Scale=rec.AssetScale or 1, Pos=rec.BottomCFrame and rec.BottomCFrame.Position })
            end
        end
    end
    table.sort(ovos, function(a, b) return a.Valor > b.Valor end)
    return ovos
end

local ovosCache = { data = {}, time = 0 }
local function listarOvosCache(force)
    local agora = tick()
    if force or agora - ovosCache.time >= CONFIG.ESP_CACHE_TIME or #ovosCache.data == 0 then
        ovosCache.data = listarOvos()
        ovosCache.time = agora
    end
    return ovosCache.data
end

task.spawn(function() listarOvosCache(true) end)

